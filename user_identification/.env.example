# iFlytek voiceprint credentials
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=

# Alibaba Cloud AK for face service
ALIBABA_AK_ID=
ALIBABA_AK_SECRET=

# Cloud database/group names — change per deployment to isolate tenants
FACE_DB_NAME=default
VOICE_GROUP_ID=default

# Voiceprint engine — uncomment the one you want
# ── xunfei cloud ──
VOICEPRINT_ENGINE=xunfei

# ── CAM++ edge (CPU/GPU) ──
# VOICEPRINT_ENGINE=campp
# VOICEPRINT_MODEL_PATH=voiceprint/campp/models/campplus_cn_common.onnx

# ── ERes2Net edge (CPU/GPU) ──
# VOICEPRINT_ENGINE=eres2net
# VOICEPRINT_MODEL_PATH=voiceprint/eres2net/models/eres2net.onnx
# VOICEPRINT_DEVICE=cuda

# ── ECAPA edge (CPU/GPU) ──
# VOICEPRINT_ENGINE=ecapa
# VOICEPRINT_MODEL_PATH=voiceprint/ecapa/models/ecapa_tdnn.onnx
# VOICEPRINT_DEVICE=cuda

# ── Shared edge settings ──
# VOICEPRINT_DB_PATH=data/chroma_db/voice
# VOICEPRINT_DEVICE=auto

# Face engine — alibaba | insightface
# ── alibaba cloud ──
FACE_ENGINE=alibaba

# ── insightface local ──
# FACE_ENGINE=insightface
# FACE_MODEL_DIR=
# FACE_CHROMA_PATH=data/chroma_db/face
# FACE_DEVICE=auto

# Score thresholds for search — scores below this are filtered out (0~1)
# VOICE_MIN_SCORE: 声纹搜索结果分数低于此值丢弃
# VOICE_MIN_SCORE=0.5
# FACE_MIN_SCORE: 人脸搜索结果分数低于此值丢弃，同时是 detect 接口 matched=True 的门槛
# FACE_MIN_SCORE=0.5

# Face thresholds
# FACE_VERIFY_THRESHOLD: 1:1 人脸验证，分数 >= 此值判定为同一人
# FACE_VERIFY_THRESHOLD=0.5
# FACE_QUALITY_THRESHOLD: 入库人脸质量分（0-100），低于此值拒绝注册
# FACE_QUALITY_THRESHOLD=30.0