# Erban Dashboard 配置示例（大屏服务 erban_dashboard_app/server.py）

# 大屏取流图像源：foxglove、camera 或 rosbridge
VIDEO_SOURCE=foxglove

# Foxglove/ROS 图像源（VIDEO_SOURCE=foxglove）
FOXGLOVE_BRIDGE_URL=ws://192.168.217.100:8768
FOXGLOVE_TOPIC=/zj_humanoid/sensor/realsense_head/color/image_raw/compressed

# ROS1 rosbridge（VIDEO_SOURCE=rosbridge；话题复用 FOXGLOVE_TOPIC）
ROSBRIDGE_URL=ws://192.168.217.100:9090

# 本地摄像头（VIDEO_SOURCE=camera）
CAMERA_ID=0

# 取流帧间隔（秒）；DASHBOARD_CAPTURE_ENABLED=false 时大屏不自取流，改由外部 POST /frame 推帧
DASHBOARD_FRAME_INTERVAL=0.1
DASHBOARD_CAPTURE_ENABLED=true

# 服务监听
SYSTEM_EVENT_HOST=0.0.0.0
SYSTEM_EVENT_PORT=8770
# SYSTEM_EVENT_HTTP_PORT=8771   # 启用 HTTPS 时附带的明文 HTTP 端口（供内部流水线推帧）

# Attention 渲染服务（Dashboard“展示关注点”开关）
ATTENTION_API_BASE=http://192.168.217.100:8011
ATTENTION_API_TIMEOUT=10

# 身份识别服务（注册/人脸检索）
IDENTITY_API_BASE=http://127.0.0.1:8001
IDENTITY_API_TIMEOUT=30

# 进程控制（可选）：uv 路径与 event_detection_new 启动后端
# UV_BIN=/home/<user>/.local/bin/uv
# EVENT_DETECTION_BACKEND=uv     # 或 docker
# EVENT_DETECTION_IMAGE=event-detection:latest

# WebSocket 鉴权（可选）
# AGENT_WS_TOKEN=
# LAUNCH_TOKEN=

LOG_LEVEL=INFO