# 图像源：foxglove、camera 或 rosbridge
VIDEO_SOURCE=foxglove

# Foxglove/ROS 图像源（VIDEO_SOURCE=foxglove）
FOXGLOVE_URL=ws://192.168.217.100:8768
FOXGLOVE_TOPIC=/zj_humanoid/sensor/realsense_head/color/image_raw/compressed

# ROS1 rosbridge（VIDEO_SOURCE=rosbridge；话题复用 FOXGLOVE_TOPIC）
ROSBRIDGE_URL=ws://192.168.217.100:9090

# 本地摄像头（VIDEO_SOURCE=camera；宽高为 0 表示设备默认值）
CAMERA_ID=0
CAMERA_WIDTH=0
CAMERA_HEIGHT=0

# Zenoh：仅固定端口，不使用 multicast 自动发现。
# 服务端监听 ZENOH_LISTEN_URL；客户端设置 ZENOH_URL=tcp/<服务端IP>:7447 显式直连
ZENOH_TOPIC=camera/annotated
ZENOH_URL=
ZENOH_LISTEN_URL=tcp/0.0.0.0:7447

# 发布格式
INCLUDE_METADATA=false
JPEG_QUALITY=85

# 服务端统一发布上限，所有图像源共用
MAX_FPS=2

# user_identification
IDENT_URL=http://127.0.0.1:8001
IDENT_TIMEOUT=30
IDENT_THRESHOLD=0.7
MAX_FACE_NUM=10

LOG_LEVEL=INFO
